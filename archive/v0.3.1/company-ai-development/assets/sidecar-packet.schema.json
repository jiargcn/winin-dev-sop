{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-sop/sidecar-packet.schema.json",
  "title": "AI SOP Sidecar Packet",
  "type": "object",
  "required": ["schemaVersion", "packetId", "phase", "createdAt", "pathBase", "repositoryRoot", "repositorySnapshot", "files"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packetId": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["plan", "final"] },
    "createdAt": { "type": "string", "minLength": 1 },
    "pathBase": { "const": "packet_directory" },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "repositorySnapshot": {
      "type": "object",
      "required": ["algorithm", "sha256", "fileCount"],
      "properties": {
        "algorithm": { "enum": ["git_worktree_content_sha256_v1", "filesystem_content_sha256_v1"] },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "fileCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "path", "portable", "hashMode", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "portable": { "type": "boolean" },
          "hashMode": { "const": "text_lf_sha256" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
